{
  "name": "reporadar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run search:index",
    "search:index": "pagefind --site out --output-path out/pagefind",
    "start": "next start",
    "lint": "eslint",
    "data:trending": "node scripts/fetch-trending.mjs",
    "data:repos": "node scripts/update-repos.mjs",
    "data:enrich": "node scripts/enrich.mjs",
    "report:daily": "node scripts/generate-reports.mjs daily",
    "report:weekly": "node scripts/generate-reports.mjs weekly",
    "report:monthly": "node scripts/generate-reports.mjs monthly",
    "pipeline:morning": "npm run data:trending && npm run data:repos && npm run data:enrich && npm run report:daily",
    "pipeline:evening": "npm run data:repos && npm run data:enrich"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.7",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
