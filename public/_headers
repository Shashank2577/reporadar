# The *.pages.dev address must never compete with the real domain in search.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# HTML and the RSC payloads (.txt) are the bulk of traffic. Cloudflare only
# caches them at the edge when a zone Cache Rule opts in ("Eligible for cache",
# respect origin TTL); s-maxage is what that rule reads. Browsers still
# revalidate every time, and data refreshes hourly so five minutes is fresh.
/*
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate

/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/opengraph-image
  ! Cache-Control
  Content-Type: image/png
  Cache-Control: public, max-age=86400
